{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jutsu-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 3210
    },
    {
      "name": "jutsu-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--package",
        "jutsu-api",
        "uvicorn",
        "jutsu_api.main:app",
        "--reload",
        "--env-file",
        ".env",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
