{
  "components": {
    "schemas": {
      "AcceptPayload": {
        "additionalProperties": false,
        "properties": {
          "full_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "token": {
            "maxLength": 128,
            "minLength": 16,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "full_name"
        ],
        "title": "AcceptPayload",
        "type": "object"
      },
      "AcceptResult": {
        "properties": {
          "destination": {
            "title": "Destination",
            "type": "string"
          },
          "jutsu_id": {
            "title": "Jutsu Id",
            "type": "string"
          }
        },
        "required": [
          "jutsu_id",
          "destination"
        ],
        "title": "AcceptResult",
        "type": "object"
      },
      "Capabilities": {
        "description": "The caller's own identity and permission set.\n\n`org_id` and `user_id` are opaque UUIDs. They are safe to return to the person they\ndescribe, and they are what the UI uses for its own routing \u2014 but they are never\naccepted back as an authorisation input, which is why no endpoint takes an org id\nfrom the client.",
        "properties": {
          "jutsu_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jutsu Id"
          },
          "org_id": {
            "title": "Org Id",
            "type": "string"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "title": "Permissions",
            "type": "array"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "org_id",
          "user_id",
          "jutsu_id",
          "role",
          "permissions"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "ChallengeAccepted": {
        "description": "Identical for every input. Carries no signal about whether the account exists.",
        "properties": {
          "status": {
            "default": "sent",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ChallengeAccepted",
        "type": "object"
      },
      "ChallengeRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ChallengeRequest",
        "type": "object"
      },
      "Employee": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "jutsu_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jutsu Id"
          },
          "last_activity_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Activity At"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Role"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "jutsu_id",
          "status",
          "role",
          "created_at",
          "last_activity_at"
        ],
        "title": "Employee",
        "type": "object"
      },
      "EmployeePage": {
        "description": "A page of people, plus the cursor for the next one.\n\n`next_cursor` is opaque and keyset-based rather than a page number. Offset paging over\na table being written to skips and duplicates rows between pages \u2014 and this table is\nwritten to exactly when an admin is looking at it, because that is when they invite.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Employee"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "EmployeePage",
        "type": "object"
      },
      "EvidenceView": {
        "description": "One chunk, with everything a citation needs to render (\u00a712 `Citation`).\n\n`char_start` and `char_end` index the **original** document, while `text` is the\nmasked body the model was given. That is deliberate and it is the trap CLAUDE.md\nrecords: highlighting the returned text with these offsets mis-highlights the span,\nbecause masking changes lengths. They address the source document, not this string.",
        "properties": {
          "char_end": {
            "title": "Char End",
            "type": "integer"
          },
          "char_start": {
            "title": "Char Start",
            "type": "integer"
          },
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "document_title": {
            "title": "Document Title",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "source_system": {
            "title": "Source System",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "chunk_id",
          "document_id",
          "document_title",
          "source_system",
          "text",
          "char_start",
          "char_end",
          "occurred_at"
        ],
        "title": "EvidenceView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InvitationAccepted": {
        "properties": {
          "status": {
            "default": "sent",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "InvitationAccepted",
        "type": "object"
      },
      "InvitePayload": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "email",
          "role"
        ],
        "title": "InvitePayload",
        "type": "object"
      },
      "LinkPayload": {
        "additionalProperties": false,
        "properties": {
          "source_system": {
            "$ref": "#/components/schemas/SourceSystem"
          },
          "subject": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "source_system",
          "subject"
        ],
        "title": "LinkPayload",
        "type": "object"
      },
      "MemberCounts": {
        "description": "Headline numbers for the overview.\n\nComputed under the tenant scope, so these are this organisation's rows and nobody\nelse's \u2014 row-level security does the filtering, not a WHERE clause someone has to\nremember to write.",
        "properties": {
          "active": {
            "title": "Active",
            "type": "integer"
          },
          "admins": {
            "title": "Admins",
            "type": "integer"
          },
          "deactivated": {
            "title": "Deactivated",
            "type": "integer"
          },
          "invited": {
            "title": "Invited",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "active",
          "invited",
          "deactivated",
          "admins"
        ],
        "title": "MemberCounts",
        "type": "object"
      },
      "OrganisationProfile": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "members": {
            "$ref": "#/components/schemas/MemberCounts"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "size_band": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Band"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "domain",
          "size_band",
          "status",
          "created_at",
          "members"
        ],
        "title": "OrganisationProfile",
        "type": "object"
      },
      "Permission": {
        "description": "What a caller may do. Namespaced `subject:verb` so the set stays readable.",
        "enum": [
          "org:read",
          "org:update",
          "org:delete",
          "member:read",
          "member:invite",
          "member:update",
          "member:assign_role",
          "integration:read",
          "integration:connect",
          "integration:revoke",
          "audit:read",
          "profile:self_read",
          "profile:self_update",
          "integration:self_manage",
          "retrieval:query"
        ],
        "title": "Permission",
        "type": "string"
      },
      "RegisterPayload": {
        "additionalProperties": false,
        "properties": {
          "company_domain": {
            "maxLength": 255,
            "minLength": 3,
            "title": "Company Domain",
            "type": "string"
          },
          "company_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Company Name",
            "type": "string"
          },
          "country": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "full_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "industry": {
            "anyOf": [
              {
                "enum": [
                  "consulting",
                  "technology",
                  "finance",
                  "healthcare",
                  "manufacturing",
                  "government",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Industry"
          },
          "job_title": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Job Title",
            "type": "string"
          },
          "org_size": {
            "maxLength": 16,
            "minLength": 1,
            "title": "Org Size",
            "type": "string"
          },
          "terms_accepted": {
            "const": true,
            "title": "Terms Accepted",
            "type": "boolean"
          },
          "work_email": {
            "format": "email",
            "title": "Work Email",
            "type": "string"
          }
        },
        "required": [
          "full_name",
          "work_email",
          "company_name",
          "company_domain",
          "job_title",
          "org_size",
          "terms_accepted"
        ],
        "title": "RegisterPayload",
        "type": "object"
      },
      "RegisterVerifyPayload": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 6,
            "minLength": 6,
            "title": "Code",
            "type": "string"
          },
          "token": {
            "maxLength": 128,
            "minLength": 16,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "code"
        ],
        "title": "RegisterVerifyPayload",
        "type": "object"
      },
      "RegistrationAccepted": {
        "description": "Deliberately says nothing about what happened.\n\nNo organisation id, no JUTSU ID, no \"already exists\". The next step is in the\nrecipient's inbox, which is the only channel that proves they control the address.",
        "properties": {
          "status": {
            "default": "check_your_email",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "RegistrationAccepted",
        "type": "object"
      },
      "RegistrationComplete": {
        "properties": {
          "destination": {
            "title": "Destination",
            "type": "string"
          }
        },
        "required": [
          "destination"
        ],
        "title": "RegistrationComplete",
        "type": "object"
      },
      "Role": {
        "enum": [
          "owner",
          "super_admin",
          "hr_admin",
          "it_admin",
          "analyst",
          "viewer",
          "member"
        ],
        "title": "Role",
        "type": "string"
      },
      "SourceIdentityPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SourceIdentityView"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "SourceIdentityPage",
        "type": "object"
      },
      "SourceIdentityView": {
        "description": "One linked identity, as a caller sees it.\n\n`subject` is returned. It is an identifier rather than a secret \u2014 the point of the\ntransparency surface is to say *which* account is linked, and an opaque row that will\nnot name it answers nothing. It is never a credential; no token is stored anywhere in\nthis product.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "linked_at": {
            "format": "date-time",
            "title": "Linked At",
            "type": "string"
          },
          "linked_by": {
            "title": "Linked By",
            "type": "string"
          },
          "revoked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          },
          "source_system": {
            "$ref": "#/components/schemas/SourceSystem"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_system",
          "subject",
          "is_active",
          "linked_at",
          "revoked_at",
          "linked_by"
        ],
        "title": "SourceIdentityView",
        "type": "object"
      },
      "SourceSystem": {
        "description": "Every system JUTSU can read from. Read-only, always (\u00a74.8).",
        "enum": [
          "local",
          "gmail",
          "m365",
          "slack",
          "jira",
          "confluence",
          "github"
        ],
        "title": "SourceSystem",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 6,
            "minLength": 6,
            "title": "Code",
            "type": "string"
          },
          "token": {
            "maxLength": 128,
            "minLength": 16,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "code"
        ],
        "title": "VerifyRequest",
        "type": "object"
      },
      "VerifyResult": {
        "properties": {
          "destination": {
            "title": "Destination",
            "type": "string"
          }
        },
        "required": [
          "destination"
        ],
        "title": "VerifyResult",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Enterprise Memory OS gateway",
    "title": "JUTSU API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Liveness. Answers whether the process is up, nothing more.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "ops"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Readiness \u2014 whether dependencies are reachable.\n\nReports `degraded` while there are no dependencies to check, rather than a bare\n`ok`: an unconditional 200 here would make the Cloud Run health gate meaningless\nthe moment Postgres and Neo4j are wired in at S1/S2.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Readyz Readyz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "description": "Revokes server-side and clears the cookies, whatever state the session was in.\n\nDeliberately not behind `get_principal`. A logout that refuses because the session\nhad already expired would leave a stale cookie in the browser and give the user no\nway to clear it \u2014 the one moment a strict check makes things less safe, not more.\n\nRevocation is server-side as well as cookie-clearing: deleting the cookie alone\nleaves the handle valid, so anyone who captured it keeps a working session.",
        "operationId": "logout_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/request": {
      "post": {
        "operationId": "request_challenge_v1_auth_request_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChallengeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Request Challenge",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/verify": {
      "post": {
        "operationId": "verify_v1_auth_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/employees": {
      "get": {
        "description": "Everyone in the caller's organisation.\n\nThe organisation is never a parameter. It comes from the session, and row-level\nsecurity scopes the query \u2014 so there is no combination of arguments that returns\nanother tenant's people.",
        "operationId": "read_employees_v1_employees_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Employees",
        "tags": [
          "employees"
        ]
      }
    },
    "/v1/employees/invitations": {
      "post": {
        "operationId": "create_invitation_v1_employees_invitations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvitePayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
