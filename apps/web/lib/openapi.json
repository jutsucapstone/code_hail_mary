    "/v1/employees/{user_id}/identities": {
      "get": {
        "description": "Which accounts are linked to one employee.\n\nRead-only, so there is no rank check: `integration:read` is the ceiling, and an\nadministrator who may see the organisation's integrations may see which of its people\nare attached to them.",
        "operationId": "read_employee_identities_v1_employees__user_id__identities_get",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceIdentityPage"
                }
