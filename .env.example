# Copy to .env and fill in. `.env` is never committed (spec §4.10); in staging and
# prod every one of these comes from Secret Manager instead.

# ---------------------------------------------------------------- web
# Absolute origin, with protocol and no trailing slash. Feeds canonical URLs,
# sitemap.xml, robots.txt and Open Graph tags. Unset means crawlers get localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# ---------------------------------------------------------------- data layer
# Matches infra/docker/compose.yml. These credentials are dev-only by design.
#
# Two roles, deliberately. The application connects as jutsu_app, which is
# NOSUPERUSER NOBYPASSRLS — a superuser bypasses row-level security unconditionally,
# so connecting as the owner would leave every tenant-isolation policy inert.
# Migrations need DDL and so run as the owner.
DATABASE_URL=postgresql+asyncpg://jutsu_app:jutsu_app_dev_only@localhost:5432/jutsu
MIGRATION_DATABASE_URL=postgresql+asyncpg://jutsu:jutsu_dev_only@localhost:5432/jutsu

# Test database. Must also be the restricted role, or the RLS suite proves nothing.
JUTSU_TEST_DATABASE_URL=postgresql+asyncpg://jutsu_app:jutsu_app_dev_only@localhost:5432/jutsu_test
JUTSU_TEST_MIGRATION_URL=postgresql+asyncpg://jutsu:jutsu_dev_only@localhost:5432/jutsu_test
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jutsu_dev_only
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- auth
# Keys the HMAC that stands in for email addresses in the org-less auth schema. That
# schema sits outside every tenant boundary, so it must never hold a readable address —
# and a shared default would make the table correlatable between deployments, so there is
# deliberately no fallback: the API refuses to start without this.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JUTSU_EMAIL_PEPPER=

# ---------------------------------------------------------------- mail
# Left blank locally: with no credential the API falls back to a console transport that
# prints the code to stdout, which is how you read a verification code in development.
# Production refuses to start without one — passwordless sign-in cannot authenticate
# anyone if it cannot send.
#
# Resend authenticates with an API key, not a mailbox: the username is the literal
# string `resend` and the password is the key. Both come from Secret Manager in
# deployed environments (jutsu-smtp-username, jutsu-smtp-password) and are never
# committed here.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# The From header, and the only thing a recipient sees in the sender column. Accepts a
# bare address or a display form; production sends the display form. The name is
# presentation only — the envelope sender is the address inside the angle brackets, so
# SPF and DKIM alignment are unaffected.
#
# The address must be on a domain verified with the provider. It is outbound only and
# needs no mailbox behind it.
SMTP_FROM=JUTSU <noreply@jutsu.co.in>

# Where the console lives, for the links in outbound mail. Absolute, with protocol and
# no trailing slash — an email has no origin to resolve a path against, so every link in
# one has to be absolute.
#
# Optional. It defaults per environment (https://jutsu.co.in in prod, this value
# otherwise), because a missing value cannot be caught at boot the way a missing SMTP
# credential can: the service would start, authenticate people, and only produce a broken
# link in mail nobody on the team reads. Set it explicitly for a preview deployment.
JUTSU_APP_URL=http://localhost:3210

# ---------------------------------------------------------------- google cloud
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=asia-south1
# Local only. Cloud Run uses the attached service account and needs no key file.
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------- models
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_EXTRACTION=gemini-2.0-pro
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# Hard ceiling per request. An agent that loops is a billing incident (§13).
TOKEN_BUDGET_PER_REQUEST=120000

# ---------------------------------------------------------------- app
LOG_LEVEL=INFO
JUTSU_ENV=dev
