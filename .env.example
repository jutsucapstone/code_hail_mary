# Copy to .env and fill in. `.env` is never committed (spec §4.10); in staging and
# prod every one of these comes from Secret Manager instead.

# ---------------------------------------------------------------- web
# Absolute origin, with protocol and no trailing slash. Feeds canonical URLs,
# sitemap.xml, robots.txt and Open Graph tags. Unset means crawlers get localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# ---------------------------------------------------------------- data layer
# Matches infra/docker/compose.yml. These credentials are dev-only by design.
#
# Two roles, deliberately. The application connects as jutsu_app, which is
# NOSUPERUSER NOBYPASSRLS — a superuser bypasses row-level security unconditionally,
# so connecting as the owner would leave every tenant-isolation policy inert.
# Migrations need DDL and so run as the owner.
DATABASE_URL=postgresql+asyncpg://jutsu_app:jutsu_app_dev_only@localhost:5432/jutsu
MIGRATION_DATABASE_URL=postgresql+asyncpg://jutsu:jutsu_dev_only@localhost:5432/jutsu

# Test database. Must also be the restricted role, or the RLS suite proves nothing.
JUTSU_TEST_DATABASE_URL=postgresql+asyncpg://jutsu_app:jutsu_app_dev_only@localhost:5432/jutsu_test
JUTSU_TEST_MIGRATION_URL=postgresql+asyncpg://jutsu:jutsu_dev_only@localhost:5432/jutsu_test
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jutsu_dev_only
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- google cloud
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=asia-south1
# Local only. Cloud Run uses the attached service account and needs no key file.
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------- models
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_EXTRACTION=gemini-2.0-pro
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# Hard ceiling per request. An agent that loops is a billing incident (§13).
TOKEN_BUDGET_PER_REQUEST=120000

# ---------------------------------------------------------------- app
LOG_LEVEL=INFO
JUTSU_ENV=dev
