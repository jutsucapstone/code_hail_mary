# Copy to .env and fill in. `.env` is never committed (spec §4.10); in staging and
# prod every one of these comes from Secret Manager instead.

# ---------------------------------------------------------------- web
# Absolute origin, with protocol and no trailing slash. Feeds canonical URLs,
# sitemap.xml, robots.txt and Open Graph tags. Unset means crawlers get localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# ---------------------------------------------------------------- data layer
# Matches infra/docker/compose.yml. These credentials are dev-only by design.
#
# Two roles, deliberately. The application connects as jutsu_app, which is
# NOSUPERUSER NOBYPASSRLS — a superuser bypasses row-level security unconditionally,
# so connecting as the owner would leave every tenant-isolation policy inert.
# Migrations need DDL and so run as the owner.
DATABASE_URL=postgresql+asyncpg://jutsu_app:jutsu_app_dev_only@localhost:5432/jutsu
MIGRATION_DATABASE_URL=postgresql+asyncpg://jutsu:jutsu_dev_only@localhost:5432/jutsu

# Test database. Must also be the restricted role, or the RLS suite proves nothing.
JUTSU_TEST_DATABASE_URL=postgresql+asyncpg://jutsu_app:jutsu_app_dev_only@localhost:5432/jutsu_test
JUTSU_TEST_MIGRATION_URL=postgresql+asyncpg://jutsu:jutsu_dev_only@localhost:5432/jutsu_test
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jutsu_dev_only
# Optional, and `neo4j` unless you have a reason. AuraDB serves one database per
# instance and names it `neo4j`; a name that does not exist fails every query rather
# than falling back.
# NEO4J_DATABASE=neo4j

# Whether answers may use the graph (ADR 0022). **Off unless set**, in every
# environment, so the feature ships dark and is turned on by configuration rather than
# by a deploy.
#
# The two halves are separately gated on purpose. The worker projects claims into the
# graph whenever NEO4J_URI is set — so the graph fills up while this stays false — and
# only this variable decides whether retrieval reads from it. That ordering is the
# rollout: configure, let it populate, verify, then enable.
#
# With it on and the graph unreachable, retrieval falls back to pgvector alone and says
# so in the response. There is no configuration of these two variables that can stop
# vector search answering.
GRAPHRAG_ENABLED=false
REDIS_URL=redis://localhost:6379
# Production rings Cloud Tasks instead (ADR 0017). All three or none — a partial set
# refuses to start. Set by deploy.yml, never by hand; listed so the names have one
# home. The worker derives its own /drain address from the request and needs only
# the first two.
# CLOUD_TASKS_QUEUE=projects/PROJECT/locations/REGION/queues/jutsu-drain
# CLOUD_TASKS_SERVICE_ACCOUNT=jutsu-runtime@PROJECT.iam.gserviceaccount.com
# WORKER_DRAIN_URL=https://jutsu-worker-HASH-el.a.run.app/drain

# ---------------------------------------------------------------- auth
# Keys the HMAC that stands in for email addresses in the org-less auth schema. That
# schema sits outside every tenant boundary, so it must never hold a readable address —
# and a shared default would make the table correlatable between deployments, so there is
# deliberately no fallback: the API refuses to start without this.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JUTSU_EMAIL_PEPPER=

# ---------------------------------------------------------------- mail
# Left blank locally: with no credential the API falls back to a console transport that
# prints the code to stdout, which is how you read a verification code in development.
# Production refuses to start without one — passwordless sign-in cannot authenticate
# anyone if it cannot send.
#
# Resend authenticates with an API key, not a mailbox: the username is the literal
# string `resend` and the password is the key. Both come from Secret Manager in
# deployed environments (jutsu-smtp-username, jutsu-smtp-password) and are never
# committed here.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# The From header, and the only thing a recipient sees in the sender column. Accepts a
# bare address or a display form; production sends the display form. The name is
# presentation only — the envelope sender is the address inside the angle brackets, so
# SPF and DKIM alignment are unaffected.
#
# The address must be on a domain verified with the provider. It is outbound only and
# needs no mailbox behind it.
SMTP_FROM=JUTSU <noreply@jutsu.co.in>

# Where the console lives, for the links in outbound mail. Absolute, with protocol and
# no trailing slash — an email has no origin to resolve a path against, so every link in
# one has to be absolute.
#
# Optional. It defaults per environment (https://jutsu.co.in in prod, this value
# otherwise), because a missing value cannot be caught at boot the way a missing SMTP
# credential can: the service would start, authenticate people, and only produce a broken
# link in mail nobody on the team reads. Set it explicitly for a preview deployment.
JUTSU_APP_URL=http://localhost:3210

# ---------------------------------------------------------------- google cloud
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=asia-south1
# Local only. Cloud Run uses the attached service account and needs no key file.
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------- knowledge basket
# The Cloud Storage bucket employees' uploaded files live in (ADR 0020). One bucket for
# the whole deployment; isolation is the `basket_files` row under FORCE row-level
# security, never the object key.
#
# Absent, `ObjectStore.from_env()` returns None and every /v1/basket route answers 503
# with "File storage is not configured" — which is correct for a deployment without
# storage and is what local development sees by default. It is NOT a credential: the
# name appears in every signed URL, and the access comes from the runtime service
# account's `storage.objectAdmin` on the bucket plus `iam.serviceAccountTokenCreator` on
# itself (that second one is what signs a URL with no private key anywhere).
#
# Production sets it from the deploy workflow as ${GCP_PROJECT_ID}-basket.
JUTSU_BASKET_BUCKET=

# ---------------------------------------------------------------- anthropic (answers + extraction)
# Grounded answer synthesis (/v1/ask) and evidence-anchored knowledge extraction both
# run on the Claude API. Absent, both surfaces report honest unavailability: /v1/ask
# refuses with 503 before spending any budget, and extraction jobs are simply never
# enqueued. Presence activates them — there is no separate feature flag.
# NOTE: the spec's §5 names Gemini for LLM work; the Claude API is used for answers and
# extraction at the owner's explicit direction (the key is the one they provisioned).
ANTHROPIC_API_KEY=
# Model overrides, read per call so a change needs no restart. Defaults: claude-opus-5.
JUTSU_ANSWER_MODEL=
JUTSU_EXTRACTION_MODEL=

# ---------------------------------------------------------------- oauth connections
# Employee-owned integrations (§2). Each provider needs an OAuth app registered in that
# provider's developer console with redirect URI {JUTSU_APP_URL}/api/jutsu/v1/connections/callback
# and READ-ONLY scopes (§4.8 — no write scope in any OAuth flow, ever). A provider with
# no credentials shows as "not configured" in the catalogue; nothing pretends.
# Pattern: JUTSU_OAUTH_{PROVIDER_ID_UPPERCASED}_CLIENT_ID / _CLIENT_SECRET, e.g.:
JUTSU_OAUTH_GOOGLE_DRIVE_CLIENT_ID=
JUTSU_OAUTH_GOOGLE_DRIVE_CLIENT_SECRET=
JUTSU_OAUTH_GMAIL_CLIENT_ID=
JUTSU_OAUTH_GMAIL_CLIENT_SECRET=
JUTSU_OAUTH_GOOGLE_CALENDAR_CLIENT_ID=
JUTSU_OAUTH_GOOGLE_CALENDAR_CLIENT_SECRET=
JUTSU_OAUTH_GOOGLE_MEET_CLIENT_ID=
JUTSU_OAUTH_GOOGLE_MEET_CLIENT_SECRET=
JUTSU_OAUTH_ONEDRIVE_CLIENT_ID=
JUTSU_OAUTH_ONEDRIVE_CLIENT_SECRET=
JUTSU_OAUTH_TEAMS_CLIENT_ID=
JUTSU_OAUTH_TEAMS_CLIENT_SECRET=
JUTSU_OAUTH_SHAREPOINT_CLIENT_ID=
JUTSU_OAUTH_SHAREPOINT_CLIENT_SECRET=
JUTSU_OAUTH_SLACK_CLIENT_ID=
JUTSU_OAUTH_SLACK_CLIENT_SECRET=
JUTSU_OAUTH_JIRA_CLIENT_ID=
JUTSU_OAUTH_JIRA_CLIENT_SECRET=
JUTSU_OAUTH_CONFLUENCE_CLIENT_ID=
JUTSU_OAUTH_CONFLUENCE_CLIENT_SECRET=
JUTSU_OAUTH_GITHUB_CLIENT_ID=
JUTSU_OAUTH_GITHUB_CLIENT_SECRET=
JUTSU_OAUTH_ZOOM_CLIENT_ID=
JUTSU_OAUTH_ZOOM_CLIENT_SECRET=
# Fernet key encrypting provider tokens at rest in connection_credentials. Generate:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Providers with credentials but no key refuse to connect rather than complete an
# exchange with nowhere lawful to store the token. Secret Manager in staging/prod.
JUTSU_CONNECTION_KEY=

# ---------------------------------------------------------------- models
# Generation models are configured in the anthropic section above: answers read
# JUTSU_ANSWER_MODEL, extraction reads JUTSU_EXTRACTION_MODEL. (GEMINI_MODEL_FAST and
# GEMINI_MODEL_EXTRACTION used to sit here; nothing ever read them.)
#
# gemini-embedding-001 with outputDimensionality=768, verified callable in
# asia-south1. Multilingual (the corpus is not ASCII-only) and MRL-truncatable to the
# 768 the chunks.embedding column and its HNSW index were built for. Its 768-wide
# output is NOT normalised by the provider; packages/retrieval normalises it.
# See ADR 0009 for the measurements behind every one of these values.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Hard ceiling per request. An agent that loops is a billing incident (§13).
#
# Read by `POST /v1/search`, which builds a fresh `TokenLedger` per request from it. The
# agent layer this was written for is still Phase 3 (§13); search is the first call to
# sit under the bound, and more will join it.
#
# The ledger is per REQUEST and never process-wide, deliberately: `TokenLedger`
# accumulates, so one shared across a long-lived API process would cross this ceiling
# some afternoon and then refuse every search for the life of the process.
#
# It is deliberately NOT the embedding ceiling below — 120 000 tokens is a sane bound on
# one question and an absurd one on a corpus, and wiring it into `EmbeddingSettings`
# would stop a 45k-document seed after a few dozen documents while looking like a
# guardrail that worked.
TOKEN_BUDGET_PER_REQUEST=120000

# How many searches one user may run per window, and how long the window is (§20).
#
# `POST /v1/search` embeds the question before it can search, so every call is a paid
# Vertex request, and `retrieval:query` is held by every role. The counter lives in
# Postgres (`search_budget`, migration 0011) rather than in process memory, because the
# API runs as more than one instance and an in-memory limiter multiplies the real
# ceiling by the instance count.
#
# Unset means the defaults below. A value of 0 is REFUSED rather than read as unlimited
# — the same reasoning as EMBEDDING_TOKEN_BUDGET.
#
# A refused request never reaches the provider, and a request that fails after passing
# the limiter still consumes its quota: the attempt is what costs money.
SEARCH_RATE_LIMIT=60
SEARCH_RATE_WINDOW_S=60

# The knowledge-transfer console's two budgets, in the same table and with the same
# semantics (migration 0019 added a `bucket` column to `search_budget`; `rate_limit.py`).
#
# KT_CLAIM_* bounds `POST /v1/kt/claim`. A KT ID is eight Crockford characters — a
# 2^40 space — and before this the only defence against guessing was the trail of denied
# opens. Ten a minute per person is far above honest use (a typo, a retry) and makes a
# probe pointless. KT_SUMMARY_* bounds the handover executive summary, one paid model
# call per press, composed fresh each time and never cached.
#
# Unset means the defaults below; 0 is REFUSED, not unlimited — the same rule as every
# other ceiling here. Unset in production today: to tune them, add the variable to the
# API's --set-env-vars in .github/workflows/deploy.yml (that flag REPLACES the env set).
KT_CLAIM_RATE_LIMIT=10
KT_CLAIM_RATE_WINDOW_S=60
KT_SUMMARY_RATE_LIMIT=6
KT_SUMMARY_RATE_WINDOW_S=60

# Hard ceiling on input tokens for ONE embedding job, enforced in code (§20). Unset means
# no ceiling; a value of 0 is refused rather than read as unlimited.
#
# `Embedder` checks it immediately before every provider request and charges it with the
# provider's own token counts afterwards, so a job cannot pass it and cannot pay past it.
# 2 000 000 is a starting point for a seed run, not a measurement — take the tokens figure
# from a bounded `make seed --max-documents 200 --embed` receipt and set this from that.
EMBEDDING_TOKEN_BUDGET=2000000

# Embedding batching. 250 instances per request was MEASURED (16.8s for 250), not
# promised — the binding constraint is requests per minute, not instances per
# request, so fewer larger requests is better and concurrency stays low.
EMBEDDING_MAX_BATCH=250
EMBEDDING_MAX_BATCH_TOKENS=20000
EMBEDDING_CONCURRENCY=2

# ---------------------------------------------------------------- app
# Root logger threshold for the API's structured JSON logs — jutsu_api.main reads it at
# startup. Case-insensitive; an unrecognised value falls back to INFO rather than
# refusing to start, because a typo in an env var must not take the service down.
LOG_LEVEL=INFO
JUTSU_ENV=dev
